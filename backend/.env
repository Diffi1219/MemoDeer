# ====== DeepSeek / LLM API 配置 ======
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Flash — 轻量 NLU 任务（知识点提取、文本结构化），低成本
LLM_FLASH_MODEL=deepseek-v4-flash

# Pro — 强推理任务（RAG 问答、复杂逻辑解答）
# 注意：deepseek-v4-pro 是推理模型，流式问答会先输出超长思维链(reasoning_content)
# 导致 60s 超时/4096 token 额度耗尽、正文(content)迟迟不出现，前端只显示参考来源。
# 改用 deepseek-v4-flash（非推理模型，秒回正文）作为问答模型。
LLM_PRO_MODEL=deepseek-v4-flash

# 本地 Ollama 8B 模型（预留 — 部署后取消注释即可切换 Flash）
# 安装方式: ollama pull qwen3:8b
# LLM_LOCAL_BASE_URL=http://localhost:11434/v1
# LLM_LOCAL_MODEL=qwen3:8b

# ====== JWT 密钥（生产环境请更换为随机字符串）======
JWT_SECRET=

# ====== 调试模式 ======
DEBUG=true

# ====== HuggingFace 镜像（国内加速 BGE 模型下载，无需代理）======
# 设为空字符串则回官方 huggingface.co
HF_ENDPOINT=https://hf-mirror.com

# ====== Embedding 模型 ======
# EMBEDDING_MODEL: 模型身份（要加载哪个模型，HuggingFace 模型 ID）
# EMBEDDING_LOCAL_DIR: 离线缓存目录（相对路径以 backend/ 为基准；留空 = 自动派生为 backend/models/<模型简称>/）
# 切换模型的最简单方式：python scripts/download_embedding.py <新模型ID>
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_LOCAL_DIR=./models/bge-small-zh-v1.5
