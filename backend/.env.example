# 不要把真实 DeepSeek API Key 写入任何会被 Git 提交的文件。
# 运行前请将它设置为本机系统环境变量。
DEEPSEEK_API_KEY=

# DeepSeek API
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Flash 用于文档格式化等轻量任务；Pro 用于检索问答和复杂推理
LLM_FLASH_MODEL=deepseek-v4-flash
LLM_PRO_MODEL=deepseek-v4-pro

# 可选：启用本地 Ollama 后，可将 Flash 任务切到 local provider
LLM_LOCAL_BASE_URL=
LLM_LOCAL_MODEL=qwen3:8b

# 向量模型：EMBEDDING_LOCAL_DIR 相对于 backend/ 目录
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_LOCAL_DIR=./models/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com

# 数据库与运行时数据通常不用配置；默认会写到 backend/data/。
# 只有在自定义位置时才取消注释：
# DATABASE_URL=sqlite+aiosqlite:///data/memo_deer.db
# UPLOAD_DIR=data/uploads
# CHROMA_DIR=data/chroma_db

# 上传与检索
MAX_UPLOAD_SIZE=10485760
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=8

# 生产部署前必须改成足够长的随机字符串
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE_MINUTES=10080
