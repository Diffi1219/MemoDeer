+async def create_note_from_text(
+    db: AsyncSession,
+    notebook_id: str,
+    content: str,
+    title: str = None,
+) -> dict:
+    """将用户编辑后的聊天回答保存为笔记文档"""
+    doc_id = uuid.uuid4().hex
+    safe_title = (title or content[:30]).strip() + " (来自对话)"
+
+    document = Document(
+        id=doc_id,
+        notebook_id=notebook_id,
+        filename=safe_title + ".md",
+        filepath="",
+        file_type="md",
+        file_size=len(content.encode("utf-8")),
+        status="completed",
+        chunk_count=1,
+    )
+    db.add(document)
+    await db.flush()
+
+    # 保存文件到磁盘
+    import os
+    from app.config import settings
+    upload_dir = os.path.join(settings.UPLOAD_DIR, notebook_id, doc_id)
+    os.makedirs(upload_dir, exist_ok=True)
+    filepath = os.path.join(upload_dir, safe_title + ".md")
+    with open(filepath, "w", encoding="utf-8") as f:
+        f.write(content)
+    document.filepath = filepath
+    await db.flush()
+
+    chunk_id = uuid.uuid4().hex
+    chunk = Chunk(
+        id=chunk_id,
+        document_id=doc_id,
+        content=content,
+        chunk_index=0,
+        token_count=estimate_tokens(content),
+    )
+    db.add(chunk)
+    await db.flush()
+
+    try:
+        embeddings = embedding_service.embed([content])
+        vector_store.add_chunks(
+            notebook_id=notebook_id,
+            chunk_ids=[chunk_id],
+            texts=[content],
+            embeddings=embeddings,
+            metadatas=[{
+                "document_id": doc_id,
+                "document_name": safe_title,
+                "chunk_index": 0,
+                "notebook_id": notebook_id,
+            }],
+        )
+    except Exception as e:
+        print(f"[Note] 笔记嵌入失败 {doc_id}: {e}")
+
+    return {
+        "document_id": doc_id,
+        "notebook_id": notebook_id,
+        "filename": safe_title,
+        "status": "completed",
+    }
+
+
+# 导出状态消息函数供 API 层使用
+sse_status = _sse_status
+sse_source = _sse_source
